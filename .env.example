# Supabase project -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "service_role" / secret key. SERVER ONLY. Never expose it in the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random string used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
